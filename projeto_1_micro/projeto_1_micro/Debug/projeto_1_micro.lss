                                 .equ	THIRDBOOTSTART	= 0x3c00
                                 .equ	FOURTHBOOTSTART	= 0x3800
                                 .equ	SMALLBOOTSTART	= FIRSTBOOTSTART
                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0002	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0004	; External Interrupt Request 1
                                 .equ	PCI0addr	= 0x0006	; Pin Change Interrupt Request 0
                                 .equ	PCI1addr	= 0x0008	; Pin Change Interrupt Request 0
                                 .equ	PCI2addr	= 0x000a	; Pin Change Interrupt Request 1
                                 .equ	WDTaddr	= 0x000c	; Watchdog Time-out Interrupt
                                 .equ	OC2Aaddr	= 0x000e	; Timer/Counter2 Compare Match A
                                 .equ	OC2Baddr	= 0x0010	; Timer/Counter2 Compare Match A
                                 .equ	OVF2addr	= 0x0012	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0014	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0016	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0018	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x001a	; Timer/Counter1 Overflow
                                 .equ	OC0Aaddr	= 0x001c	; TimerCounter0 Compare Match A
                                 .equ	OC0Baddr	= 0x001e	; TimerCounter0 Compare Match B
                                 .equ	OVF0addr	= 0x0020	; Timer/Couner0 Overflow
                                 .equ	SPIaddr	= 0x0022	; SPI Serial Transfer Complete
                                 .equ	URXCaddr	= 0x0024	; USART Rx Complete
                                 .equ	UDREaddr	= 0x0026	; USART, Data Register Empty
                                 .equ	UTXCaddr	= 0x0028	; USART Tx Complete
                                 .equ	ADCCaddr	= 0x002a	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x002c	; EEPROM Ready
                                 .equ	ACIaddr	= 0x002e	; Analog Comparator
                                 .equ	TWIaddr	= 0x0030	; Two-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0032	; Store Program Memory Read
                                 
                                 .equ	INT_VECTORS_SIZE	= 52	; size in words
                                 
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ; projeto_1_micro.asm
                                 ;
                                 ; Autores:
                                 ; Jackson Bruno Lima Leão
                                 ; Pedro Henrique Santos Resende
                                 ; Thiago Ribeiro da Silva
                                 ; Willian Tcheldon Oliveira Santos
                                 
                                 
                                 ; Mapeamento:
                                 ; Semáforo 0 (Pedestre): PD0 (Vermelho = 0, Verde = 1)
                                 ; Semáforo 1: PD7 (Vermelho) PD6 (Amarelo) PD5 (Verde)
                                 ; Semáforo 2: PB2 (Vermelho) PB1 (Amarelo) PB0 (Verde)
                                 ; Semáforo 3: PB5 (Vermelho) PB4 (Amarelo) PB3 (Verde)
                                 ; Semáforo 4: PD4 (Vermelho) PD3 (Amarelo) PD2 (Verde)
                                 ; 2 BCDs: PC0 (S0) PC1 (S1) PC2 (S2) PC3 (S3) PC4 (OE BCD1) PC5 (OE BCD2)
                                 ; Serial (USART0): PD1 (TX), 9600 baud, 8N1, transmissão por interrupção
                                 ; (UDRE). Envia uma linha de texto a cada mudança de estado.
                                 ; O programa assume displays multiplexados, OE ativo em zero,
                                 ; LEDs acesos com nivel alto e clock de 16 MHz.
                                 
                                 ; Definição de Constantes
                                 .equ N_ESTADOS = 11 
                                 #define CLOCK 16.0e6 ; clock
                                 #define DELAY 5.0e-3 ; 5 ms
                                 .equ PRESCALE = 0b011 ; /64 prescale
                                 .equ PRESCALE_DIV = 64
                                 .equ WGM = 0b0100 ; Modo CTC (Clear to Compare)
                                 .equ TOP = int(0.5 + ((CLOCK/PRESCALE_DIV)*DELAY))
                                 ;16 mhz clock speed, 9600 baud UBRR = 103
                                 .equ UBRR_VAL = 103
                                 .equ TAM_BUFFER_TX = 80 ; uma linha tem 79 caracteres + o 0 do fim
                                 
                                 ; Validação do valor TOP (precisa ser <= 2 bytes)
                                 .if TOP > 65535
                                 .endif
                                 
                                 ; Nomeação de registradores
                                 .def temp      = r16
                                 .def estado    = r17
                                 .def duracao   = r18
                                 .def cont_s3   = r19
                                 .def unidade   = r20
                                 .def dezena    = r21
                                 .def cont_5ms  = r22
                                 .def mux       = r23
                                 .def caractere = r24
                                 
                                 ; Memória de dados (SRAM): buffer com a linha de texto a ser enviada
                                 .dseg
000100                           BUFFER_TX: .byte TAM_BUFFER_TX
                                 
                                 .cseg
                                 
                                 ; Inicialização dos vetores de interrupção
000000 940c 0028                 jmp RESET
                                 .org OC1Aaddr
000016 940c 0056                 jmp TIMER1_COMPA_ISR
                                 .org UDREaddr
000026 940c 0069                 jmp USART_UDRE_ISR
                                 
                                 RESET:
                                 	; Inicialização da pilha
000028 ef0f                      	ldi temp, low(RAMEND)
000029 bf0d                      	out SPL, temp
00002a e008                      	ldi temp, high(RAMEND)
00002b bf0e                      	out SPH, temp
                                 
                                 	; configura como saída os pinos usados pros LEDs e Displays
00002c ef0f                      	ldi temp, $FF
00002d b904                      	out DDRB, temp
00002e ef0d                      	ldi temp, 0b11111101
00002f b90a                      	out DDRD, temp
000030 e30f                      	ldi temp, 0b00111111
000031 b907                      	out DDRC, temp
                                 
                                 	; incializa contador de 1s (200 * 5ms) e o
                                 	; registrador de multiplexação
000032 ec68                      	ldi cont_5ms, 200
000033 2777                      	clr mux
                                 
                                 	; programa começando no estado 0
000034 e010                      	ldi estado, 0
000035 d045                      	rcall CARREGA_ESTADO
                                 
                                 	; habilita interrupção de timer
000036 9100 006f                 	lds	 temp, TIMSK1
000038 6002                      	sbr temp, 1<<OCIE1A
000039 9300 006f                 	sts TIMSK1, temp
                                 
                                 	; Configurações de inicialização do Timer 1 com duração de 5ms
                                 
                                 	; inicializa o valor de comparação do Timer 1 (TOP)
00003b e004                      	ldi temp, high(TOP)
00003c 9300 0089                 	sts OCR1AH, temp
00003e ee02                      	ldi temp, low(TOP)
00003f 9300 0088                 	sts OCR1AL, temp
                                 
                                 	; define modo CTC e Prescale = 64
000041 e000                      	ldi temp, ((WGM&0b11) << WGM10) ;lower 2 bits of WGM
                                 	; WGM&0b11 = 0b0100 & 0b0011 = 0b0000 
000042 9300 0080                 	sts TCCR1A, temp
000044 e00b                      	ldi temp, ((WGM>> 2) << WGM12)|(PRESCALE << CS10)
                                 	; WGM >> 2 = 0b0100 >> 2 = 0b0001
                                 	; (WGM >> 2) << WGM12 = (0b0001 << 3) = 0b0001000
                                 	; (PRESCALE << CS10) = 0b011 << 0 = 0b011
                                 	; 0b0001000 | 0b011 = 0b0001011
000045 9300 0081                 	sts TCCR1B, temp ; inicia timer
                                 
                                 	; Inicializa USART
000047 e000                      	ldi temp, high(UBRR_VAL)
000048 9300 00c5                 	sts UBRR0H, temp
00004a e607                      	ldi temp, low(UBRR_VAL)
00004b 9300 00c4                 	sts UBRR0L, temp
                                 
                                 	;8 bits, 1 stop, no parity
00004d e006                      	ldi temp, (3<<UCSZ00)
00004e 9300 00c2                 	sts UCSR0C, temp
                                 	; habilita só o transmissor
000050 e008                      	ldi temp, (1<<TXEN0)
000051 9300 00c1                 	sts UCSR0B, temp
                                 
000053 9478                      	sei ; ativa flag de interrupção global
                                 
000054 d04a                      	rcall MONTA_MENSAGEM
                                 
                                 	LOOP_PRINCIPAL:
000055 cfff                      		rjmp LOOP_PRINCIPAL
                                 
                                 TIMER1_COMPA_ISR:
                                 	; Interrupções a cada 5ms. Faz a multiplexação dos displays
                                 	; a cada interrupção e, a cada 200 interrupções (200 * 5ms = 1s),
                                 	; atualiza os dados da maquina de estados
                                 
                                 	; armazena SREG e temp na pilha
000056 930f                      	push temp
000057 b70f                      	in temp, SREG
000058 930f                      	push temp
                                 
000059 d03a                      	rcall MULTIPLEXA
                                 
00005a 956a                      	dec cont_5ms
00005b f4d9                      	brne FINALIZA_ISR
00005c ec68                      	ldi cont_5ms, 200
                                 
                                 	; decrementa duração do estado
00005d 952a                      	dec duracao
                                 	; quando duracao = 0, muda estado
00005e f019                      	breq MUDANCA_ESTADO
                                 	; decrementa duração até mudança de cor no Semáforo 3
00005f 953a                      	dec cont_s3
000060 d02a                      	rcall ATUALIZA_VALOR_DISPLAY
000061 c015                      	rjmp FINALIZA_ISR
                                 
                                 	MUDANCA_ESTADO:
000062 9513                      		inc estado
                                 		; quando estado = N_ESTADO, estado = 0
000063 301b                      		cpi estado, N_ESTADOS
000064 f409                      		brne FINALIZA_MUDANCA
000065 e010                      		ldi estado, 0
                                 		; carrega estado atual e volta para finalizar o ISR
                                 		FINALIZA_MUDANCA:
000066 d014                      			rcall CARREGA_ESTADO
                                 			; monta a linha do novo estado e inicia o envio pela serial
000067 d037                      			rcall MONTA_MENSAGEM
000068 c00e                      			rjmp FINALIZA_ISR
                                 
                                 USART_UDRE_ISR:
                                 	; Interrupção "USART Data Register Empty": o UDR0 está livre.
                                 	; Envia o próximo caractere do BUFFER_TX; se for o 0 do fim,
                                 	; desliga a interrupção (senão ela continuaria disparando, já que
                                 	; o UDR0 continua vazio).
                                 	;
                                 	; Entrada: Y apontando para o próximo caractere do BUFFER_TX
000069 930f                      	push temp
00006a b70f                      	in temp, SREG
00006b 930f                      	push temp
                                 
00006c 9109                      	ld temp, Y+
00006d 2300                      	tst temp
00006e f019                      	breq USART_UDRE_FIM
00006f 9300 00c6                 	sts UDR0, temp          ; envia o caractere
000071 c005                      	rjmp FINALIZA_ISR
                                 
                                 	USART_UDRE_FIM:
                                 		; fim da mensagem: desliga a interrupção UDRE
000072 9100 00c1                 		lds temp, UCSR0B
000074 7d0f                      		cbr temp, (1<<UDRIE0)
000075 9300 00c1                 		sts UCSR0B, temp
                                 
                                 FINALIZA_ISR:
                                 	; retoma valor de SREG
000077 910f                      	pop temp
000078 bf0f                      	out SREG, temp
000079 910f                      	pop temp
00007a 9518                      	reti
                                 
                                 CARREGA_ESTADO:
                                 	; lê a linha do estado atual na TABELA_ESTADOS, acende os leds e
                                 	; carrega a duração e contador do semáforo 3
                                 	;
                                 	; Entrada: estado (0 a N_ESTADOS - 1)
                                 	; Saída: PORTB, PORTD, duracao, cont_s3, unidade, dezena
                                 
00007b efee                      	ldi ZL, low(TABELA_ESTADOS*2)
00007c e0f1                      	ldi ZH, high(TABELA_ESTADOS*2)
00007d 2f01                      	mov temp, estado
                                 	; Cada estado tem 4 bytes, então, multiplicamos estado * 4 e somamos
                                 	; ao endereço inicial da tabela para pegar os dados do estado atual
00007e 0f00                      	lsl temp
00007f 0f00                      	lsl temp
000080 0fe0                      	add ZL, temp
000081 2700                      	clr temp
000082 1ff0                      	adc ZH, temp
                                 	; 1ª byte: configuração do estado em PORTB
000083 9105                      	lpm temp, Z+
000084 b905                      	out PORTB, temp
                                 	; 2ª byte: configuração do estado em PORTD
000085 9105                      	lpm temp, Z+
000086 b90b                      	out PORTD, temp
                                 	; 3ª byte: duração do estado
000087 9125                      	lpm duracao, Z+
                                 	; 4ª byte: duração até mudança de cor no Semáforo 3 (display)
000088 9135                      	lpm cont_s3, Z+
                                 	; Atualiza valor do display com cont_s3 novo
000089 d001                      	rcall ATUALIZA_VALOR_DISPLAY
00008a 9508                      	ret
                                 
                                 ATUALIZA_VALOR_DISPLAY:
                                 	; Atualiza valores de dezena e unidade usados no display
                                 	; com o valor atual de cont_s3
                                 	;
                                 	; Entrada: cont_s3
                                 	; Saída: unidade, dezena
00008b 2f03                      	mov temp, cont_s3
00008c 2755                      	clr dezena
                                 	CONVERTE_DEZENAS:
00008d 300a                      		cpi temp, 10
00008e f018                      		brlo FIM_CONVERSAO
00008f 500a                      		subi temp, 10
000090 9553                      		inc dezena
000091 cffb                      		rjmp CONVERTE_DEZENAS
                                 	FIM_CONVERSAO:
000092 2f40                      		mov unidade, temp
000093 9508                      		ret
                                 
                                 MULTIPLEXA:
                                 	; alterna o dígito exibido a cada chamada (5ms). Escreve o valor BCD
                                 	; em PC0-3 e habilita o OE do display correspondente (OE ativo em
                                 	; nível baixo)
                                 	;
                                 	; Os displays começam habilitados (0E = 0) e são desabilitados
                                 	; quando o outro precisa receber o valor BCD
                                 	;
                                 	; Entrada: mux (0 = dezena, 1 = unidade), dezena, unidade
                                 	; Saída: PORTC, ~mux
000094 2377                      	tst mux
000095 f421                      	brne MOSTRA_UNIDADE
                                 	MOSTRA_DEZENA:
000096 2f05                      		mov temp, dezena
                                 		; Desabilita OE do Display 1 (Unidade)
000097 6100                      		ori temp, (1<<PC4)
000098 e071                      		ldi mux, 1
000099 c003                      		rjmp ESCREVE
                                 	MOSTRA_UNIDADE:
00009a 2f04                      		mov temp, unidade
                                 		; Desabilita OE do Display 2 (Dezena)
00009b 6200                      		ori temp, (1<<PC5)
00009c 2777                      		clr mux
                                 	ESCREVE:
00009d b908                      		out PORTC, temp
00009e 9508                      		ret
                                 
                                 MONTA_MENSAGEM:
                                 	; Escreve no BUFFER_TX a linha de texto do estado atual e liga a
                                 	; interrupção UDRE para começar o envio. As cores são lidas direto
                                 	; de PORTB e PORTD, então o texto mostra exatamente o que está aceso
                                 	; nos LEDs.
                                 	;
                                 	; Entrada: estado, duracao, PORTB, PORTD
                                 	; Saída: BUFFER_TX, Y (início do buffer), UDRIE0 = 1
                                 
                                 	; X aponta para onde o próximo caractere será escrito no buffer
00009f e0a0                      	ldi XL, low(BUFFER_TX)
0000a0 e0b1                      	ldi XH, high(BUFFER_TX)
                                 
                                 	; "Estado " + número do estado (estado + 1, igual à TABELA_ESTADOS)
0000a1 e2ea                      	ldi ZL, low(TXT_ESTADO*2)
0000a2 e0f2                      	ldi ZH, high(TXT_ESTADO*2)
0000a3 d055                      	rcall COPIA_TEXTO
0000a4 2f01                      	mov temp, estado
0000a5 9503                      	inc temp
0000a6 d047                      	rcall ESCREVE_NUMERO
                                 
                                 	; Semáforo 0 (pedestre): PD0 = 1 -> verde, PD0 = 0 -> vermelho
0000a7 e3e2                      	ldi ZL, low(TXT_S0*2)
0000a8 e0f2                      	ldi ZH, high(TXT_S0*2)
0000a9 d04f                      	rcall COPIA_TEXTO
0000aa e004                      	ldi temp, 0b100          ; vermelho
0000ab 9958                      	sbic PORTD, PD0          ; se PD0 = 1...
0000ac e001                      	ldi temp, 0b001          ; ...verde
0000ad d030                      	rcall ESCREVE_COR
                                 
                                 	; Para os semáforos 1 a 4, os 3 bits de cada um são deslocados para
                                 	; as posições 2 (vermelho), 1 (amarelo) e 0 (verde) de temp
                                 
                                 	; Semáforo 1: PD7 PD6 PD5 -> desloca PORTD 5 bits para a direita
0000ae e3e8                      	ldi ZL, low(TXT_S1*2)
0000af e0f2                      	ldi ZH, high(TXT_S1*2)
0000b0 d048                      	rcall COPIA_TEXTO
0000b1 b10b                      	in temp, PORTD
0000b2 9506                      	lsr temp
0000b3 9506                      	lsr temp
0000b4 9506                      	lsr temp
0000b5 9506                      	lsr temp
0000b6 9506                      	lsr temp
0000b7 d026                      	rcall ESCREVE_COR
                                 
                                 	; Semáforo 2: PB2 PB1 PB0 -> já estão nas posições certas
0000b8 e3ec                      	ldi ZL, low(TXT_S2*2)
0000b9 e0f2                      	ldi ZH, high(TXT_S2*2)
0000ba d03e                      	rcall COPIA_TEXTO
0000bb b105                      	in temp, PORTB
0000bc d021                      	rcall ESCREVE_COR
                                 
                                 	; Semáforo 3: PB5 PB4 PB3 -> desloca PORTB 3 bits para a direita
0000bd e4e0                      	ldi ZL, low(TXT_S3*2)
0000be e0f2                      	ldi ZH, high(TXT_S3*2)
0000bf d039                      	rcall COPIA_TEXTO
0000c0 b105                      	in temp, PORTB
0000c1 9506                      	lsr temp
0000c2 9506                      	lsr temp
0000c3 9506                      	lsr temp
0000c4 d019                      	rcall ESCREVE_COR
                                 
                                 	; Semáforo 4: PD4 PD3 PD2 -> desloca PORTD 2 bits para a direita
0000c5 e4e4                      	ldi ZL, low(TXT_S4*2)
0000c6 e0f2                      	ldi ZH, high(TXT_S4*2)
0000c7 d031                      	rcall COPIA_TEXTO
0000c8 b10b                      	in temp, PORTD
0000c9 9506                      	lsr temp
0000ca 9506                      	lsr temp
0000cb d012                      	rcall ESCREVE_COR
                                 
                                 	; duração do estado: "(" + segundos + " s)" + quebra de linha
0000cc e4e8                      	ldi ZL, low(TXT_DUR_INI*2)
0000cd e0f2                      	ldi ZH, high(TXT_DUR_INI*2)
0000ce d02a                      	rcall COPIA_TEXTO
0000cf 2f02                      	mov temp, duracao
0000d0 d01d                      	rcall ESCREVE_NUMERO
0000d1 e4ea                      	ldi ZL, low(TXT_DUR_FIM*2)
0000d2 e0f2                      	ldi ZH, high(TXT_DUR_FIM*2)
0000d3 d025                      	rcall COPIA_TEXTO
                                 
                                 	; 0 no fim do buffer marca o fim da mensagem
0000d4 2788                      	clr caractere
0000d5 938c                      	st X, caractere
                                 
                                 	; Y volta para o início do buffer e a interrupção UDRE é ligada.
                                 	; Como o UDR0 já está livre, ela dispara logo em seguida e começa
                                 	; a enviar a mensagem.
0000d6 e0c0                      	ldi YL, low(BUFFER_TX)
0000d7 e0d1                      	ldi YH, high(BUFFER_TX)
0000d8 9100 00c1                 	lds temp, UCSR0B
0000da 6200                      	sbr temp, (1<<UDRIE0)
0000db 9300 00c1                 	sts UCSR0B, temp
0000dd 9508                      	ret
                                 
                                 ESCREVE_COR:
                                 	; Escreve no buffer o nome da cor acesa de um semáforo
                                 	;
                                 	; Entrada: temp com bit 2 = vermelho, bit 1 = amarelo, bit 0 = verde
                                 	; (os outros bits são ignorados), X
0000de e5e0                      	ldi ZL, low(TXT_VERMELHO*2)
0000df e0f2                      	ldi ZH, high(TXT_VERMELHO*2)
0000e0 fd02                      	sbrc temp, 2
0000e1 c00a                      	rjmp ESCREVE_COR_FIM
0000e2 e5ea                      	ldi ZL, low(TXT_AMARELO*2)
0000e3 e0f2                      	ldi ZH, high(TXT_AMARELO*2)
0000e4 fd01                      	sbrc temp, 1
0000e5 c006                      	rjmp ESCREVE_COR_FIM
0000e6 e6e4                      	ldi ZL, low(TXT_VERDE*2)
0000e7 e0f2                      	ldi ZH, high(TXT_VERDE*2)
0000e8 fd00                      	sbrc temp, 0
0000e9 c002                      	rjmp ESCREVE_COR_FIM
0000ea e6ee                      	ldi ZL, low(TXT_APAGADO*2)
0000eb e0f2                      	ldi ZH, high(TXT_APAGADO*2)
                                 	ESCREVE_COR_FIM:
0000ec d00c                      		rcall COPIA_TEXTO
0000ed 9508                      		ret
                                 
                                 ESCREVE_NUMERO:
                                 	; Escreve no buffer um número de 0 a 99 como 2 dígitos ASCII
                                 	; (ex.: 7 -> "07"). Somar '0' (48) converte o dígito em ASCII.
                                 	;
                                 	; Entrada: temp (0 - 99), X
0000ee e380                      	ldi caractere, '0'
                                 	ESCREVE_NUMERO_DEZENAS:
0000ef 300a                      		cpi temp, 10
0000f0 f018                      		brlo ESCREVE_NUMERO_FIM
0000f1 500a                      		subi temp, 10
0000f2 9583                      		inc caractere
0000f3 cffb                      		rjmp ESCREVE_NUMERO_DEZENAS
                                 	ESCREVE_NUMERO_FIM:
0000f4 938d                      		st X+, caractere        ; dezena
0000f5 2f80                      		mov caractere, temp
0000f6 5d80                      		subi caractere, -'0'    ; soma '0' (o AVR não tem addi)
0000f7 938d                      		st X+, caractere        ; unidade
0000f8 9508                      		ret
                                 
                                 COPIA_TEXTO:
                                 	; Copia um texto da memória de programa (flash) para o buffer
                                 	; (SRAM), até encontrar o byte 0 (fim do texto). O 0 não é copiado.
                                 	;
                                 	; Entrada: Z apontando para o texto (endereço * 2), X
0000f9 9185                      	lpm caractere, Z+
0000fa 2388                      	tst caractere
0000fb f011                      	breq COPIA_TEXTO_FIM
0000fc 938d                      	st X+, caractere
0000fd cffb                      	rjmp COPIA_TEXTO
                                 	COPIA_TEXTO_FIM:
0000fe 9508                      		ret
                                 
                                 TABELA_ESTADOS:
                                 ;   PORTB       PORTD      dur  S3 (tempo até mudança de cor no S3)
0000ff 9124
000100 0e0c                      .db 0b00100100, 0b10010001, 12, 14     ; E1: pedestre verde
000101 9024
000102 0202                      .db 0b00100100, 0b10010000,  2,  2     ; E2: todos vermelhos
000103 9009
000104 5816                      .db 0b00001001, 0b10010000, 22, 88     ; E3: S2 e S3 verdes
000105 900a
000106 4204                      .db 0b00001010, 0b10010000,  4, 66     ; E4: S2 amarelo, S3 verde
000107 900c
000108 3e01                      .db 0b00001100, 0b10010000,  1, 62     ; E5: S3 verde
000109 840c
00010a 3d3d                      .db 0b00001100, 0b10000100, 61, 61     ; E6: S3 e S4 verdes
00010b 8814
00010c 0404                      .db 0b00010100, 0b10001000,  4,	 4     ; E7: S3 e S4 amarelos
00010d 9024
00010e 2d01                      .db 0b00100100, 0b10010000,  1, 45     ; E8: todos vermelhos
00010f 3024
000110 2c19                      .db 0b00100100, 0b00110000, 25, 44     ; E9: S1 verde
000111 5024
000112 1304                      .db 0b00100100, 0b01010000,  4, 19     ; E10: S1 amarelo
